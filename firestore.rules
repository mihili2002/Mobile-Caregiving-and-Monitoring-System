rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user matches the document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: Users can read/write their own profile
    // Caregivers/Therapists might need to read others (handled by logic or broader rules)
    // For Development: Allow all authenticated users to read/write all documents
    // This resolves the immediate "Permission Denied" error.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
